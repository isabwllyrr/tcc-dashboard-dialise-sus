---
interface ForecastPoint {
  periodo: string;
  central: { valor: number };
  limite_inferior_95: { valor: number };
  limite_superior_95: { valor: number };
}

interface Props {
  points: ForecastPoint[];
  ariaLabel: string;
}

const { points, ariaLabel } = Astro.props;
const width = 940;
const height = 430;
const left = 86;
const right = 24;
const top = 36;
const bottom = 62;
const plotWidth = width - left - right;
const plotHeight = height - top - bottom;
const values = points.flatMap((point) => [point.limite_inferior_95.valor, point.limite_superior_95.valor]);
const rawMin = Math.min(...values);
const rawMax = Math.max(...values);
const padding = (rawMax - rawMin) * 0.08;
const min = rawMin - padding;
const max = rawMax + padding;
const x = (index: number) => left + index * (plotWidth / Math.max(1, points.length - 1));
const y = (value: number) => top + ((max - value) / (max - min || 1)) * plotHeight;
const upper = points.map((point, index) => `${x(index).toFixed(1)},${y(point.limite_superior_95.valor).toFixed(1)}`);
const lower = points.map((point, index) => `${x(index).toFixed(1)},${y(point.limite_inferior_95.valor).toFixed(1)}`).reverse();
const central = points.map((point, index) => `${x(index).toFixed(1)},${y(point.central.valor).toFixed(1)}`).join(" ");
const compactMoney = new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL", notation: "compact", maximumFractionDigits: 0 });
const exactMoney = new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
const ticks = [0, 1, 2, 3, 4].map((step) => {
  const value = max - (step / 4) * (max - min);
  return { value, y: top + (step / 4) * plotHeight };
});
---
<svg class="fig forecast-figure" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={ariaLabel}>
  {ticks.map((tick) => (
    <g>
      <line class="grid" x1={left} x2={width - right} y1={tick.y} y2={tick.y} />
      <text class="axis forecast-axis" x={left - 14} y={tick.y + 4} text-anchor="end">{compactMoney.format(tick.value)}</text>
    </g>
  ))}
  <polygon class="forecast-band" points={[...upper, ...lower].join(" ")} />
  <polyline class="series forecast-line" points={central} />
  {points.map((point, index) => (
    <g class="forecast-point" tabindex="0">
      <circle cx={x(index)} cy={y(point.central.valor)} r="5" />
      <title>{point.periodo}: {exactMoney.format(point.central.valor)}; intervalo de 95% entre {exactMoney.format(point.limite_inferior_95.valor)} e {exactMoney.format(point.limite_superior_95.valor)}</title>
    </g>
  ))}
  {points.map((point, index) => index % 2 === 0 || index === points.length - 1 ? (
    <text class="axis forecast-month" x={x(index)} y={height - 24} text-anchor="middle">{point.periodo}</text>
  ) : null)}
</svg>
