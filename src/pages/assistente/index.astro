---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Assistente" description="Assistente do DialisaSUS para consultar evidências agregadas do SIA/SUS e do IBGE.">
  <section class="assistant-intro">
    <div>
      <p class="eyebrow">Assistente de evidências</p>
      <h1 class="claim">Pergunte aos <em>dados do painel</em>.</h1>
      <p class="standfirst">Respostas curtas, baseadas no dossiê validado e acompanhadas da fonte para conferência.</p>
    </div>
    <dl class="assistant-status" aria-label="Escopo do assistente">
      <div><dt>Fontes</dt><dd>SIA/SUS + IBGE</dd></div>
      <div><dt>Cobertura</dt><dd>Dados agregados</dd></div>
      <div><dt>Uso</dt><dd>Apoio à gestão</dd></div>
    </dl>
  </section>

  <section class="assistant-workspace" aria-labelledby="agent-label">
    <div class="assistant-prompts" aria-label="Perguntas sugeridas">
      <span>Experimente</span>
      <button type="button" class="prompt-chip" data-question="Como os valores aprovados mudaram após a pandemia?">Custos pós-pandemia</button>
      <button type="button" class="prompt-chip" data-question="Qual é a principal cautela na comparação entre estados?">Comparação territorial</button>
      <button type="button" class="prompt-chip" data-question="Qual modelo apresentou o menor MAPE no backtest?">Desempenho dos modelos</button>
    </div>

    <form method="POST" action="/api/agent" class="agent-form" id="agent-form">
      <label for="pergunta" id="agent-label">Sua pergunta</label>
      <div class="agent-composer">
        <textarea id="pergunta" name="pergunta" rows="3" maxlength="500" placeholder="Pergunte sobre custos, produção, território ou previsão..." required></textarea>
        <button type="submit" aria-label="Consultar assistente">
          <span>Consultar</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
      <p class="form-hint">O assistente analisa procedimentos aprovados, não pessoas ou casos clínicos.</p>
    </form>

    <article id="agent-answer" class="agent-answer" aria-live="polite" tabindex="-1" hidden>
      <div class="answer-head">
        <span class="answer-status">Resposta</span>
        <span class="answer-source" id="agent-source"></span>
      </div>
      <p id="agent-answer-text"></p>
      <p class="answer-warning" id="agent-warning" hidden></p>
      <a id="agent-route" class="answer-route" href="/sobre-a-base/">Ver evidência completa <span aria-hidden="true">↗</span></a>
    </article>
  </section>

  <p class="assistant-note">O agente não busca dados externos nem substitui avaliação clínica. Cada resposta é limitada às evidências já publicadas no DialisaSUS.</p>

  <Fragment slot="scripts">
    <script src="/assets/assistant.js" defer></script>
  </Fragment>
</BaseLayout>
