---
import BaseLayout from "../layouts/BaseLayout.astro";
import LineChart from "../components/LineChart.astro";
import { ptInt, ptNumber, readDossie } from "../lib/dossie";
const nacional = readDossie("nacional.json");
const total = nacional.achados.find((a: any) => a.id === "G3.achado.total_procedimentos").valores[0].valor;
const meses = nacional.series.g3_quantidade_mensal;
const inicio = meses[0].periodo;
const fim = meses.at(-1).periodo;
const provisorios = meses.filter((p: any) => p.estado === "provisorio");
const provisionalLabel = new Intl.ListFormat("pt-BR", { style: "long", type: "conjunction" }).format(provisorios.map((p: any) => new Intl.DateTimeFormat("pt-BR", { month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(`${p.periodo}-01T00:00:00Z`))));

// A virada: nenhum numero digitado. O nominal vem da serie; o real e o valor
// por procedimento vem dos achados. Ver docs/PLANO-V3-CONCEITO-C.md §3.
const anual = nacional.series.g1_valor_anual;
const nominais = anual.filter((p: any) => p.unidade === "reais_correntes");
const variacaoNominal = (nominais.at(-1).valor / nominais[0].valor - 1) * 100;
const anoInicio = nominais[0].periodo;
const anoFim = nominais.at(-1).periodo;
const variacaoReal = nacional.achados.find((a: any) => a.id === "G1.achado.variacao_real").valores[0].valor;
const porProcedimento = nacional.achados
  .find((a: any) => a.id === "G2.achado.periodos")
  .valores.find((v: any) => v.chave === "variacao_valor_real_por_procedimento").valor;
const lastObservedIndex = meses.findLastIndex((p: any) => p.estado === "observado");
const observedValues = meses.map((p: any, index: number) => index <= lastObservedIndex ? p.valor : Number.NaN);
const provisionalValues = meses.map((p: any, index: number) => index >= lastObservedIndex ? p.valor : Number.NaN);
---
<BaseLayout title="Início">
  <div class="home-intro">
    <p class="eyebrow">Painel nacional</p>
    <h1 class="claim">Diálise no SUS, <em>em escala nacional</em>.</h1>
    <p class="standfirst">Produção, valor, território e previsão em uma leitura única de 2015 a 2026.</p>
  </div>

  <section class="home-organ" aria-labelledby="organ-title">
    <div class="section-heading"><p class="eyebrow">Sistema renal</p><h2 id="organ-title">Do órgão ao procedimento</h2></div>
    <div class="organ">
    <section class="stage" id="kidney-stage" aria-label="Rim e circuito externo">
      <div class="fallback" id="kidney-fallback">
        <figure><img src="/assets/kidney-position.webp" width="560" height="420" alt="Rim humano ilustrado em três dimensões, com cápsula avermelhada e vasos superficiais" /><figcaption>Posição</figcaption></figure>
        <figure><img src="/assets/kidney-hilum.webp" width="560" height="420" alt="Vista do hilo, região de entrada e saída de vasos no rim esquerdo" /><figcaption>Entrada do sangue</figcaption></figure>
      </div>
      <div class="kidney-controls"><button type="button" data-view="position" aria-pressed="true">Posição</button><button type="button" data-view="hilum" aria-pressed="false">Entrada do sangue</button><button type="button" id="enable-3d">Carregando 3D</button><span class="kidney-hint">arraste diretamente sobre o rim</span></div>
    </section>
    <section class="organ-copy">
      <p>Na insuficiência renal avançada, um circuito externo assume parte da filtragem. O tratamento se repete e cada atendimento aprovado pode gerar um registro no SIA/SUS.</p>
      <div class="circuit" aria-label="Esquema do circuito externo"><span class="node">corpo</span><span class="flow"></span><span class="node">filtro</span><span class="flow"></span><span class="node">corpo</span></div>
      <p class="asset-credit">Modelo anatômico interativo. O circuito é esquemático.</p>
    </section>
    </div>
  </section>

  <section class="home-kpis" aria-label="Indicadores nacionais">
    <div class="readouts">
      <div class="readout"><p class="label">Procedimentos aprovados</p><p class="value">{ptNumber(total / 1_000_000, 2)} mi</p><p class="sub">{inicio} a {fim}</p></div>
      <div class="readout"><p class="label">Valor nominal</p><p class="value">+{ptNumber(variacaoNominal, 2)}%</p><p class="sub">{anoInicio} a {anoFim}</p></div>
      <div class="readout"><p class="label">Valor corrigido</p><p class="value">+{ptNumber(variacaoReal, 2)}%</p><p class="sub">reais de jun/2026</p></div>
      <div class="readout"><p class="label">Valor real por procedimento</p><p class="value">{ptNumber(porProcedimento, 2)}%</p><p class="sub">pré x pós-pandemia</p></div>
    </div>
  </section>

  <figure class="home-trend">
    <div class="figure-head"><span class="id">SIA/SUS</span><h2 class="title">Procedimentos aprovados por mês</h2><span class="meta">{inicio} — {fim}</span></div>
    <div class="plot"><LineChart labels={meses.map((p: any) => p.periodo)} series={[{ label: "Observado", className: "observed", values: observedValues }, { label: "Provisório", className: "provisional", values: provisionalValues }]} ariaLabel="Evolução mensal dos procedimentos de diálise aprovados no SUS" /></div>
    <figcaption>A linha tracejada identifica as competências provisórias mais recentes.</figcaption>
  </figure>

  <div class="home-actions" aria-label="Análises disponíveis">
    <a href="/evidencias/valor/"><span>Valor</span><b>Nominal x corrigido</b></a>
    <a href="/evidencias/territorio/"><span>Território</span><b>Estados e municípios</b></a>
    <a href="/evidencias/modelo/"><span>Previsão</span><b>Próximos 12 meses</b></a>
  </div>
  <p class="home-disclaimer">A base representa procedimentos aprovados, não pessoas. {provisionalLabel} são competências provisórias. Dados por local de atendimento.</p>
  <Fragment slot="scripts"><script type="module" src="/assets/kidney.js"></script></Fragment>
</BaseLayout>
